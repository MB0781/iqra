---
import Base from '../layouts/Base.astro';
import TexteArabe from '../components/arabe/TexteArabe.tsx';
import BoutonAudio from '../components/ui/BoutonAudio.tsx';
import DemoExercice from '../components/exercices/DemoExercice.tsx';
import Marque from '../components/ui/Marque.astro';
import { contenus, itemsPour, refsExercice } from '../content/charger';
import { resoudreRef } from '../lib/coran';

const l = contenus().lecons[0];
const exemples = [l.pratique[0], l.pratique[4]];
const items = itemsPour(exemples.flatMap(refsExercice));
const motDemo = resoudreRef('q:1:3:1');
const couleurs = [
  ['papier', 'Fond de page'], ['surface', 'Panneaux'], ['surface-2', 'Zones en retrait'], ['encre', 'Texte'], ['encre-2', 'Texte secondaire'],
  ['trait', 'Filets'], ['accent', 'Accent unique'], ['accent-doux', 'Accent doux'], ['erreur', 'Erreur'], ['attention', 'Attention'],
];
const voyelles = [['v-fatha', 'lettre avec fatha (ou tanwin an)'], ['v-kasra', 'avec kasra (ou in)'], ['v-damma', 'avec damma (ou oun)'], ['v-signe', 'avec soukoun']];
const tailles = [['text-4xl', '52 px'], ['text-3xl', '40 px'], ['text-2xl', '30 px'], ['text-xl', '24 px'], ['text-lg', '20 px'], ['text-base', '17 px'], ['text-sm', '15 px'], ['text-xs', '13 px']];
---
<Base titre="Design system" description="Les tokens et composants d'Iqra'." noindex>
  <div class="conteneur pt-10 sm:pt-14">
    <h1 class="text-3xl font-semibold">Design system</h1>
    <p class="mt-2 max-w-xl text-lg text-encre-2">Vitrine des tokens et composants. Référence écrite : docs/DESIGN.md.</p>

    <section class="mt-14" aria-labelledby="d-couleurs">
      <h2 id="d-couleurs" class="text-xl font-semibold">Couleurs</h2>
      <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-5">
        {couleurs.map(([t, n]) => (
          <li class="overflow-hidden rounded-[var(--radius-md)] border border-trait">
            <div class="h-14" style={`background: var(--${t})`}></div>
            <div class="bg-surface p-2 text-xs"><code>--{t}</code><br /><span class="text-encre-2">{n}</span></div>
          </li>
        ))}
      </ul>
      <h3 class="mt-8 font-semibold">Aide « couleur des voyelles » : chaque lettre prend la couleur de sa voyelle</h3>
      <ul class="mt-3 flex flex-wrap gap-4">
        {voyelles.map(([t, n]) => (
          <li class="flex items-center gap-2 text-sm"><span class="h-4 w-4 rounded-full" style={`background: var(--${t})`}></span>{n}</li>
        ))}
      </ul>
    </section>

    <section class="mt-14" aria-labelledby="d-typo">
      <h2 id="d-typo" class="text-xl font-semibold">Typographie</h2>
      <ul class="mt-4 space-y-2">
        {tailles.map(([c, px]) => (
          <li class="flex items-baseline gap-4"><span class="w-14 shrink-0 text-xs text-encre-3">{px}</span><span class={c}>Lire, lettre après lettre</span></li>
        ))}
      </ul>
      <h3 class="mt-8 font-semibold">Arabe</h3>
      <div class="mt-3 flex flex-wrap items-end gap-8">
        <div><TexteArabe texte="بَ" etude /><p class="text-xs text-encre-3">Lettre étudiée, 56 px</p></div>
        <div><TexteArabe texte="كَتَبَ" /><p class="text-xs text-encre-3">Exercice, 36 px</p></div>
        <div><TexteArabe texte={motDemo.texte} coranRef={`1:3:${motDemo.de}-${motDemo.a}`} /><p class="text-xs text-encre-3">Coran, Amiri Quran</p></div>
      </div>
    </section>

    <section class="mt-14" aria-labelledby="d-aides">
      <h2 id="d-aides" class="text-xl font-semibold">Aides à la lecture</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {[
          ['Sans aide', {}],
          ['Voyelles colorées', { voyelles: true }],
          ['Lettres espacées', { espacement: true }],
          ['Syllabes', { syllabes: true }],
        ].map(([t, a]) => (
          <div class="panneau p-4 text-center">
            <TexteArabe texte={motDemo.texte} coranRef={`1:3:${motDemo.de}-${motDemo.a}`} aides={a as object} etude />
            <p class="text-sm text-encre-2">{t as string}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-14" aria-labelledby="d-boutons">
      <h2 id="d-boutons" class="text-xl font-semibold">Boutons et audio</h2>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <button type="button" class="bouton bouton-principal">Action principale</button>
        <button type="button" class="bouton bouton-secondaire">Secondaire</button>
        <button type="button" class="bouton bouton-discret">Discret</button>
        <button type="button" class="bouton bouton-principal" disabled>Désactivé</button>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-6">
        <BoutonAudio client:visible url={items['lettre-ba']?.audio ?? null} libelle="exemple" />
        <BoutonAudio client:visible url="https://audio.qurancdn.com/wbw/001_003_001.mp3" libelle="ar-raḥmân" taille="grande" />
      </div>
    </section>

    <section class="mt-14" aria-labelledby="d-retours">
      <h2 id="d-retours" class="text-xl font-semibold">Panneaux d’information</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <div class="rounded-[var(--radius-md)] border border-accent/40 bg-accent-doux p-4"><p class="font-semibold">Juste.</p><p class="text-encre-2">Retour positif avec explication.</p></div>
        <div class="rounded-[var(--radius-md)] border border-erreur/40 bg-erreur-doux p-4"><p class="font-semibold">Pas tout à fait.</p><p class="text-encre-2">Retour d’erreur, toujours explicatif.</p></div>
        <div class="rounded-[var(--radius-md)] bg-attention-doux p-4"><p class="font-semibold">Attention</p><p class="text-encre-2">Mise en garde dans une leçon.</p></div>
        <div class="flex items-center gap-3 panneau p-4"><Marque taille={32} class="text-accent" /><p class="text-encre-2">Marque : étoile à huit branches dessinée pour le projet.</p></div>
      </div>
    </section>

    <section class="mt-14 max-w-2xl" aria-labelledby="d-exos">
      <h2 id="d-exos" class="text-xl font-semibold">Exercices</h2>
      {exemples.map((ex) => (
        <div class="panneau mt-4 p-4 sm:p-6"><DemoExercice client:visible ex={ex} items={items} /></div>
      ))}
    </section>
  </div>
</Base>
